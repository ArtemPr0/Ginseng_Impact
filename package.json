{
  "name": "ginseng-impact",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run colliders && tsc --noEmit && node scripts/procedural-audit.mjs && node scripts/music-audit.mjs && vite build",
    "audit:procedural": "node scripts/procedural-audit.mjs",
    "todo:models": "node scripts/model-todo.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "colliders": "node --experimental-strip-types --no-warnings scripts/collider-grids.mjs",
    "voices": "node --experimental-strip-types --no-warnings scripts/voices.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
